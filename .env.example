# Copy to .env and adjust. Never commit .env.
PORT=3000

# Public URL of YOUR office server (used by hermes-bridge.js).
# Local default works when bridge + server share one machine.
OFFICE_URL=http://localhost:3000

# Require this secret on /webhook/* (header x-office-secret).
# Empty = webhooks accept localhost only. Set a long random value
# whenever the server is reachable from LAN/internet.
OFFICE_WEBHOOK_SECRET=
