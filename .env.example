# ============================================================
#  Agent Office 3D — konfigurasi milikmu, JANGAN di-commit.
#  Mulai:  cp .env.example .env   lalu edit .env dengan editor.
#  File ini aman di-commit; nilai aslinya tidak.
# ============================================================

# Port HTTP + WebSocket dashboard kantor.
PORT=3000

# Alamat server kantor yang dituju hermes-bridge.js (hook Hermes).
# Sama mesin = bawaan cukup. Beda mesin = isi alamat kantormu.
OFFICE_URL=http://localhost:3000

# Kata sandi webhook + API. WAJIB diisi kalau server bisa diakses
# dari LAN/internet. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dikirim sebagai header 'x-office-secret'. Kosong = hanya localhost
# (dan dashboard same-origin) yang boleh spawn.
OFFICE_WEBHOOK_SECRET=

# Opsional: batasi origin browser yang boleh manggil API (pisah koma).
# Kosong = semua origin boleh (normal untuk dashboard lokal).
# Contoh: OFFICE_ALLOWED_ORIGIN=http://192.168.20.246:3000,https://kantor.example.com
OFFICE_ALLOWED_ORIGIN=

# Catatan: variabel yang sudah di-set di shell/PM2 menang atas isi .env.
